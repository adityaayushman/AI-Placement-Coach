# Copy to .env. Never commit .env.
APP_ENV=development
LOG_LEVEL=INFO
SECRET_KEY=change-me-to-a-long-random-string
CORS_ORIGINS=http://localhost:5173
DATABASE_URL=postgresql+psycopg://placement:placement@db:5432/placement
REDIS_URL=redis://redis:6379/0
POSTGRES_USER=placement
POSTGRES_PASSWORD=placement
POSTGRES_DB=placement
STORAGE_DIR=/app/storage
MODEL_DIR=/app/models
# Run background jobs in-process (no Redis worker needed).
JOBS_INLINE=false
UPLOAD_MAX_MB=5
AUTH_RATE_LIMIT_PER_MINUTE=20
SYNTHETIC_ROWS=1500
# Optional heavy backends (pip install ".[ml-heavy]").
USE_SENTENCE_TRANSFORMERS=false
USE_FASTER_WHISPER=false
USE_DKT=false
# Bootstrap admin account created at startup if both are set.
ADMIN_EMAIL=
ADMIN_PASSWORD=
VITE_API_URL=http://localhost:8000
